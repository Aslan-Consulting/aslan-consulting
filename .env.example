NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Calendar booking (Cal.com or Calendly). Used after a successful discovery submit.
# Query params appended: name, email
#   Cal.com:   https://cal.com/aslan-consulting/discovery?name=Jordan+Hale&email=jordan%40acme.com
#   Calendly:  https://calendly.com/aslan-consulting/discovery?name=Jordan+Hale&email=jordan%40acme.com
NEXT_PUBLIC_CAL_BOOKING_URL=https://cal.com/aslan-consulting/discovery

# Optional aliases (first non-empty wins):
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/aslan-consulting/discovery
# CALENDLY_URL=https://calendly.com/aslan-consulting/discovery

# Resend notify for discovery fallback and the homepage consulting waitlist.
# All three required. Waitlist signup fails closed if any are missing.
# Discovery still succeeds when they are unset; email is skipped.
# DISCOVERY_NOTIFY_EMAIL is the inbox that receives both (MJ checks this one).
# RESEND_API_KEY=
# DISCOVERY_NOTIFY_EMAIL=majdaslan4@gmail.com
# DISCOVERY_FROM_EMAIL=Aslan Consulting <noreply@aslan.consulting>
